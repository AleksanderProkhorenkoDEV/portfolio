---

<div class="relative">
  <h1
    aria-hidden="true"
    id="name-hidden"
    class="invisible text-3xl sm:text-5xl lg:text-7xl leading-tight wrap-break-words"
  >
    ALEKSANDER TRUJILLO PROKHORENKO
  </h1>

  <h1
    id="name"
    class="absolute inset-0 text-3xl sm:text-5xl lg:text-7xl leading-tight wrap-break-words after:ml-0.5 after:content-['|'] after:text-main"
  >
  </h1>
</div>

<script>
  let intervalId: number | null = null;

  function initTypewriter() {
    const hidden = document.getElementById("name-hidden");
    const target = document.getElementById("name");
    if (!hidden || !target) return;

    if (intervalId) clearInterval(intervalId); // limpiar navegación anterior

    const fallback = hidden.textContent;
    let title = "";
    let letterCount = 0;

    target.innerHTML = ""; 
    target.classList.remove("after:animate-pulse");

    intervalId = setInterval(() => {
      const letter = fallback?.charAt(letterCount);
      letterCount += 1;
      title += letter;
      target.innerHTML = title;
      if (fallback === title && intervalId != null) {
        clearInterval(intervalId);
        intervalId = null;
        target.classList.add("after:animate-pulse");
      }
    }, 250);
  }

  document.addEventListener("astro:page-load", initTypewriter);
</script>
