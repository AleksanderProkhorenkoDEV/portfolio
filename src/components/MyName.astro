---

<div class="relative">
  <h1
    aria-hidden="true"
    class="invisible text-3xl sm:text-5xl lg:text-7xl leading-tight wrap-break-words"
  >
    ALEKSANDER TRUJILLO PROKHORENKO
  </h1>

  <h1
    id="name"
    class="absolute inset-0 text-3xl sm:text-5xl lg:text-7xl leading-tight wrap-break-words after:ml-0.5 after:content-['|'] after:text-main"
  >
  </h1>
</div>

<script>
  const fallback = "ALEKSANDER TRUJILLO PROKHORENKO";
  let title = "";
  let letterCount = 0;

  const intervalId = setInterval(() => {
    const letter = fallback?.charAt(letterCount);
    letterCount += 1;
    title += letter;
    document.getElementById("name")!.innerHTML = title;
    if (fallback === title) {
      clearInterval(intervalId);
      document.getElementById("name")?.classList.add("after:animate-pulse");
    }
  }, 250);

  document.addEventListener(
    "astro:before-swap",
    () => {
      clearInterval(intervalId);
    },
    { once: true },
  );
</script>
