<h1
  id="name"
  class="text-3xl sm:text-5xl lg:text-7xl leading-tight wrap-break-words after:ml-0.5 after:content-['|'] after:text-main"
>
  ALEKSANDER TRUJILLO PROKHORENKO
</h1>

<script>
  let intervalId: number | null = null;

  function initTypewriter() {
    const target = document.getElementById("name");
    if (!target) return;

    target.style.clipPath = "inset(0 100% 0 0)"; 
    target.offsetHeight;

    target.style.transition = "clip-path 2s steps(33)";
    target.style.clipPath = "inset(0 0% 0 0)";

    setTimeout(() => {
      target.style.transition = "";
      target.classList.add("after:animate-pulse");
    }, 2000);
  }

  document.addEventListener("astro:page-load", initTypewriter);
</script>
