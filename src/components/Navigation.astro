---
import MyName from "./MyName.astro";

const pathname = Astro.url.pathname;
const links = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
];
---

<div class="flex flex-col gap-4 min-h-screen w-full">
  <div class="w-auto mt-10 ml-4 sm:ml-10 lg:ml-20">
    <MyName />
    <p class="text-xl sm:text-2xl lg:text-3xl text-foreground/60 text-left">
      Web developer
    </p>
  </div>

  <div
    class="flex flex-col lg:flex-row gap-6 lg:gap-4 w-full h-full py-6 px-4 sm:px-10 lg:py-10 lg:px-20"
  >
    <nav class="w-full lg:w-[15%] shrink-0 flex items-center justify-center">
      <ul
        class="text-lg lg:text-xl flex flex-row flex-wrap lg:flex-col gap-4 capitalize items-center justify-center"
      >
        {
          links.map((link) => {
            const isActive = pathname === link.href;
            return (
              <li>
                <a
                  href={link.href}
                  class={
                    isActive ? "text-main" : "hover:text-main transition-colors"
                  }
                  aria-current={isActive ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
        <li>
          <a
            href="https://www.linkedin.com/in/aleksander-trujillo-prokhorenko-90a066299/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="hover:text-main transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="1em"
              height="1em"
              viewBox="0 0 24 24"
            >
              <path d="M0 0h24v24H0z" fill="none"></path>
              <path
                fill="currentColor"
                fill-rule="evenodd"
                d="M9.429 8.969h3.714v1.85c.535-1.064 1.907-2.02 3.968-2.02c3.951 0 4.889 2.118 4.889 6.004V22h-4v-6.312c0-2.213-.535-3.461-1.897-3.461c-1.889 0-2.674 1.345-2.674 3.46V22h-4zM2.57 21.83h4V8.799h-4zM7.143 4.55a2.53 2.53 0 0 1-.753 1.802a2.57 2.57 0 0 1-1.82.748a2.6 2.6 0 0 1-1.818-.747A2.55 2.55 0 0 1 2 4.55c0-.677.27-1.325.753-1.803A2.58 2.58 0 0 1 4.571 2c.682 0 1.336.269 1.819.747s.753 1.126.753 1.803"
                clip-rule="evenodd"></path>
            </svg>
          </a>
        </li>
        <li>
          <a
            href="mailto:aprokhorenkodev@gmail.com"
            aria-label="Enviar correo"
            class="hover:text-main transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="1em"
              height="1em"
              viewBox="0 0 32 32"
            >
              <path d="M0 0h32v32H0z" fill="none"></path>
              <path
                fill="currentColor"
                d="M32 6v20c0 1.135-.865 2-2 2h-2V9.849l-12 8.62l-12-8.62V28H2c-1.135 0-2-.865-2-2V6c0-.568.214-1.068.573-1.422A1.97 1.97 0 0 1 2 4h.667L16 13.667L29.333 4H30c.568 0 1.068.214 1.427.578c.359.354.573.854.573 1.422"
              ></path>
            </svg>
          </a>
        </li>
      </ul>
    </nav>

    <main class="flex-1 w-full">
      <slot />
    </main>
  </div>
</div>
