---
import ThreeScene from "../components/ThreeScene";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="flex h-full items-end  max-lg:flex-col max-lg:items-center">
    <div class="flex-2  h-full max-xl:w-1/2 max-lg:w-full">
      <ThreeScene client:only="react" />
    </div>
    <div class="max-w-sm h-fit flex-1">
      <h4 class="font-jetbrain mb-2">>_ About Me</h4>
      <hr class="text-main mb-2" />

      <div class="space-y-2">
        <p class="text-pretty">
          I am looking for job as web developer o multiplatform. Recently I
          finish the degree of multiplaform developer.
        </p>
        <p class="text-pretty">
          My main focus is web development and I have worked on several
          full-stack projects, the last I made is a bank app with web component
          and java spring boot.
        </p>
        <p class="text-pretty">
          I enjoy learning new technologies and experiment with as.
        </p>
        <p class="text-pretty">
          Outside the programing I like cook, 3D Design and motorcycles.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
