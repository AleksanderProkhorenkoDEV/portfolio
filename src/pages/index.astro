---
import ThreeScene from "../components/ThreeScene";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="flex h-full items-end max-lg:flex-col max-lg:items-center">
    <div class="flex-2 h-full max-xl:w-1/2 max-lg:w-full">
      <ThreeScene client:only="react" />
    </div>
    <div class="max-w-sm h-fit flex-1">
      <h4 class="font-jetbrain mb-2">>_ About Me</h4>
      <hr class="text-main mb-2" />

      <div class="space-y-2">
        <p class="text-pretty">
          I am looking for a job as a web developer or in multiplatform
          development. I recently finished my degree in Multiplatform
          Application Development.
        </p>
        <p class="text-pretty">
          My main focus is web development, and I have worked on several
          full-stack projects. The last one I made is a banking app with web
          components and Java Spring Boot.
        </p>
        <p class="text-pretty">
          I enjoy learning new technologies and experimenting with them.
        </p>
        <p class="text-pretty">
          Outside of programming, I like cooking, 3D design, and motorcycles.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
